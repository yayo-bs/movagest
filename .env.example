# Selecciona desarrollo o produccion como configuración de Flask.
FLASK_CONFIG=desarrollo
# Clave de ejemplo local; genera una clave privada antes de desplegar.
SECRET_KEY=clave-local-de-ejemplo-no-usar-en-produccion
# URI SQLite por defecto; en producción define la URI de la base de datos.
DATABASE_URL=sqlite:///movagest.db
# Nombre visible de la asociación en las páginas y documentos.
NOMBRE_ASOCIACION=MovaGest
# Carpeta de archivos subidos, relativa a instance si no es absoluta.
CARPETA_SUBIDAS=subidas
# Tamaño máximo total de la petición, expresado en bytes (10 MiB).
MAX_CONTENT_LENGTH=10485760
# Activa el modo de depuración solo durante el desarrollo local.
FLASK_DEBUG=false
# Requiere HTTPS para enviar la cookie de sesión cuando sea true.
SESSION_COOKIE_SECURE=false
